# ── Server-side secrets (NUNCA usar prefixo VITE_ — variáveis VITE_ vão para o
#    bundle do navegador e ficam públicas). Configure no dashboard da Vercel. ──

# Coach IA — get your key at https://console.anthropic.com/
# Usada apenas pelas funções em /api/ai/* (nunca exposta ao navegador).
ANTHROPIC_API_KEY=sk-ant-...

# Mesma string de VITE_FIREBASE_API_KEY abaixo, mas SEM o prefixo VITE_.
# Obrigatória no servidor: /api/ai/_auth.js a usa para validar o token do
# Firebase. Sem ela, todas as chamadas autenticadas são rejeitadas.
FIREBASE_API_KEY=replace_with_your_api_key

# ── Notificações push (api/push/*) ────────────────────────────────────────────
# Sem estas variáveis o cron responde "not configured" e nada é enviado.

# Par de chaves VAPID: npx web-push generate-vapid-keys
# A pública aparece DUAS vezes — o servidor assina com ela, o navegador se
# inscreve com ela. A privada NUNCA leva prefixo VITE_.
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_EMAIL=mailto:seu@email.com

# Conta de serviço do Firebase em base64 — usada por DUAS coisas:
#   1. o cron de push, que lê o Firestore server-side para saber a que horas
#      avisar cada usuário e se o dia já foi registrado;
#   2. o placar do desafio (api/challenge/sync.js), que é o único que pode
#      escrever em `challenges/` — as regras negam a escrita do navegador.
# Sem ela o placar responde 503 e o app mostra a contagem local rotulada como
# "não confirmada". Firebase Console → Configurações → Contas de serviço → gerar
# chave privada, depois:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=replace_with_base64_service_account

# Segredo do cron — string aleatória que você mesmo gera:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A Vercel envia este valor no header Authorization das execuções agendadas,
# só por a variável se chamar CRON_SECRET.
CRON_SECRET=replace_with_random_secret

# Firebase Auth — create a project at https://console.firebase.google.com
# Project settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=replace_with_your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=replace_with_your_app_id

# Origem publicada do app — entra nas tags Open Graph do index.html.
# O WhatsApp e o Google buscam a imagem de prévia de um servidor que não conhece
# a página, então a URL precisa ser ABSOLUTA. Sem esta variável o build usa
# localhost e o link compartilhado chega sem imagem.
VITE_SITE_URL=https://seu-dominio.com.br
