STRAVA_CLIENT_ID=229036
STRAVA_CLIENT_SECRET=replace_with_strava_client_secret
STRAVA_APP_URL=http://localhost:3000
STRAVA_SCOPES=read,activity:read
STRAVA_COOKIE_SECRET=replace_with_random_32_byte_secret

# Optional: used only if you register a Strava webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token
STRAVA_WEBHOOK_SIGNING_SECRET=

# ── Server-side secrets (NUNCA usar prefixo VITE_ — variáveis VITE_ vão para o
#    bundle do navegador e ficam públicas). Configure no dashboard da Vercel. ──

# Coach IA — get your key at https://console.anthropic.com/
# Usada apenas pelas funções em /api/ai/* (nunca exposta ao navegador).
ANTHROPIC_API_KEY=sk-ant-...

# Mesma string de VITE_FIREBASE_API_KEY abaixo, mas SEM o prefixo VITE_.
# Obrigatória no servidor: /api/ai/_auth.js a usa para validar o token do
# Firebase. Sem ela, todas as chamadas autenticadas são rejeitadas.
FIREBASE_API_KEY=replace_with_your_api_key

# ── Coaching proativo (push) ─────────────────────────────────────────────────
# Sem estas três variáveis o cron /api/push/cron vira no-op e o webhook do
# Strava não notifica — o resto do app continua funcionando normalmente.

# Chaves VAPID do Web Push. Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contato@therisepln.com.br

# Segredo do Vercel Cron — o handler rejeita chamadas sem este Bearer token.
CRON_SECRET=replace_with_random_secret

# Service account do Firebase em base64, para o servidor ler o Firestore:
#   Console → Project Settings → Service Accounts → Generate new private key
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=

# Firebase Auth — create a project at https://console.firebase.google.com
# Project settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=replace_with_your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=replace_with_your_app_id
