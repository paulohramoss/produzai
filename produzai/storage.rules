rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Os tetos usam `<=` para casar com a checagem do cliente, que recusa
    // acima do limite. Com `<`, um arquivo de exatamente 10 MB passava no app e
    // era negado aqui — erro que só aparece na borda e é difícil de reproduzir.
    // (Na prática o cliente reduz a imagem antes de enviar; ver
    // src/lib/imageUpload.ts. Estes valores são a folga, não o alvo.)
    match /users/{userId}/progress/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/avatar {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
