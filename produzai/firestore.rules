rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Assinatura ────────────────────────────────────────────────────────
    //
    // `billing/{uid}` é ESCRITO SÓ PELO SERVIDOR (api/billing/*, via
    // firebase-admin, que passa por cima destas regras). Se o navegador pudesse
    // escrever aqui, o paywall inteiro seria decoração: um `setDoc` no console
    // liberaria o app.
    //
    // O usuário lê o próprio documento porque a tela precisa dizer "sua fatura
    // está em atraso" em vez de um bloqueio mudo.
    match /billing/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Mapa cliente-do-Asaas → uid e registro de eventos do webhook. Coisa de
    // servidor; o app não tem nada que ver com isso.
    match /billingCustomers/{customerId} { allow read, write: if false; }
    match /billingEvents/{eventId}      { allow read, write: if false; }

    /**
     * Assinatura em dia.
     *
     * É a MESMA conta que api/_entitlement.js faz, aplicada onde o app não pode
     * intermediar: o SDK do Firestore fala direto com o banco a partir do
     * navegador, então bloquear só a tela deixaria a porta dos dados aberta.
     *
     * `.get(campo, padrão)` em vez de acesso direto porque documento recém-criado
     * pode não ter todos os campos — e campo ausente derruba a regra inteira.
     */
    function entitled() {
      let path = /databases/$(database)/documents/billing/$(request.auth.uid);
      return exists(path)
        && (get(path).data.get('freeAccess', false) == true
            || get(path).data.get('activeUntil', 0) > request.time.toMillis());
    }

    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * Documentos que continuam graváveis sem assinatura.
     *
     * Não é "usar o app": é o que o cadastro precisa escrever ANTES de existir
     * pagamento — o consentimento da LGPD, a origem de quem indicou, o clube do
     * link de convite. Sem esta exceção, criar conta quebraria no meio.
     */
    function accountDoc(docName) {
      return docName in ['profile', 'friends', 'club'];
    }

    match /users/{userId} {
      allow read, write: if owner(userId);


      // data/* — documentos principais (workouts, diet, profile, projects, books)
      //
      // A LEITURA nunca depende de assinatura: quem deixou de pagar não perde os
      // dados, nem a exportação deles (LGPD, art. 18). O que a assinatura vencida
      // tira é a ESCRITA — registrar treino, dieta, plano. Ver accountDoc().
      match /data/{docName} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && (accountDoc(docName) || entitled());
        // APAGAR nunca depende de assinatura. `write` inclui `delete`, e gatear
        // o delete travava a exclusão de conta de quem deixou de pagar — ou
        // seja, transformava atraso de pagamento em recusa do direito de
        // eliminação (LGPD, art. 18, VI).
        allow delete: if owner(userId);
      }

      // daily/{date} — hábitos e foco diário (mantido durante transição)
      match /daily/{date} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }

      // mental/{date} — entradas de bem-estar diário (mantido durante transição)
      match /mental/{date} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }

      // dailyMonthly/{yyyy-MM} — agregação mensal de hábitos/foco (1-2 leituras vs 35)
      match /dailyMonthly/{month} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }

      // mentalMonthly/{yyyy-MM} — agregação mensal de bem-estar
      match /mentalMonthly/{month} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }

      // journal/{date} — diário de treino (sentimentos, dores, motivação)
      match /journal/{date} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }

      // journalMonthly/{yyyy-MM} — agregação mensal do diário de treino
      match /journalMonthly/{month} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && entitled();
        allow delete: if owner(userId);
      }
    }

    // Leaderboard público (leitura para autenticados, escrita só para o próprio uid).
    // A escrita é validada: esquema fixo, tipos corretos, faixas de valores e
    // uid/inviteCode amarrados à identidade — impede forjar entrada de outro
    // usuário e limita valores absurdos. (Anti-cheat completo de xp exige
    // cálculo server-side; aqui apenas restringimos o que pode ser gravado.)
    function validLeaderboardEntry(userId) {
      let d = request.resource.data;
      return d.uid == userId
        && d.keys().hasOnly(['uid', 'displayName', 'xp', 'streakDays',
                             'weeklyWorkouts', 'weeklyXP', 'weekKey',
                             'monthlyWorkouts', 'monthKey',
                             'inviteCode', 'updatedAt'])
        && d.displayName is string && d.displayName.size() <= 80
        && d.xp is number && d.xp >= 0 && d.xp <= 100000000
        && d.streakDays is number && d.streakDays >= 0 && d.streakDays <= 100000
        && d.weeklyWorkouts is number && d.weeklyWorkouts >= 0 && d.weeklyWorkouts <= 1000
        && d.weeklyXP is number && d.weeklyXP >= 0 && d.weeklyXP <= 100000000
        && d.weekKey is string && d.weekKey.size() <= 12
        && d.monthlyWorkouts is number && d.monthlyWorkouts >= 0 && d.monthlyWorkouts <= 1000
        && d.monthKey is string && d.monthKey.size() <= 8
        && d.inviteCode == userId[0:6].upper()
        && d.updatedAt is number;
    }

    // Entrar no ranking é uso do produto: exige assinatura em dia. A LEITURA
    // não — quem está no paywall ainda vê o placar dos outros na landing do app.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && entitled()
                            && validLeaderboardEntry(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Desafio ───────────────────────────────────────────────────────────
    // O placar é ESCRITO SÓ PELO SERVIDOR (api/challenge/sync.js, via
    // firebase-admin, que passa por cima destas regras). O cliente lê e nada
    // mais.
    //
    // Por que a escrita saiu daqui: nenhuma regra expressável neste arquivo
    // resolve o problema de fundo. Os treinos que alimentam o placar moram em
    // users/{uid}/data/workouts, documento do próprio usuário — ele pode gravar
    // 21 treinos de uma vez, e qualquer validação de esquema aceitaria. O que
    // separa treino de invenção é O MOMENTO em que o registro chegou, e só o
    // servidor tem um relógio confiável para isso.
    //
    // (A versão anterior tinha aqui um teto de calendário e duas constantes
    // duplicadas de src/lib/challenge.ts. Saíram junto com a escrita: o
    // servidor lê challenge.json e não há mais nada para manter em sincronia.)
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /entries/{userId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Clube ─────────────────────────────────────────────────────────────
    // Grupo fechado com meta coletiva. A leitura é aberta a autenticados porque
    // entrar exige ler o clube pelo código; o documento não guarda nada além de
    // nome, meta e lista de uids.
    //
    // A atualização tem dois caminhos exclusivos e nada além deles:
    //   1. entrar/sair — o único campo que muda é memberUids, e a diferença é
    //      exatamente o próprio uid (ninguém adiciona nem remove terceiros);
    //   2. o dono edita nome e meta — e não pode mexer na lista por essa via.
    function clubMemberDelta() {
      return request.resource.data.memberUids.toSet()
             .difference(resource.data.memberUids.toSet())
             .union(resource.data.memberUids.toSet()
                    .difference(request.resource.data.memberUids.toSet()));
    }

    function isSelfMembershipChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
             && clubMemberDelta() == [request.auth.uid].toSet()
             && request.resource.data.memberUids.size() <= 30;
    }

    function isOwnerConfigChange() {
      return resource.data.ownerUid == request.auth.uid
             && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['name', 'monthlyGoal'])
             && request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 40
             && request.resource.data.monthlyGoal is int
             && request.resource.data.monthlyGoal > 0
             && request.resource.data.monthlyGoal <= 100000;
    }

    match /clubs/{clubId} {
      allow read: if request.auth != null;

      // Criar clube e editar suas configurações é uso do produto — pede
      // assinatura. ENTRAR num clube não: é o que o link de convite faz no
      // cadastro, antes de existir pagamento (ver isSelfMembershipChange).
      allow create: if request.auth != null
                    && entitled()
                    && request.resource.data.keys().hasOnly(
                         ['id', 'name', 'ownerUid', 'memberUids', 'monthlyGoal', 'createdAt'])
                    && request.resource.data.id == clubId
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.monthlyGoal is int
                    && request.resource.data.monthlyGoal > 0
                    && request.resource.data.monthlyGoal <= 100000
                    && request.resource.data.createdAt is number;

      allow update: if request.auth != null
                    && (isSelfMembershipChange() || (entitled() && isOwnerConfigChange()));

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Link read-only do treinador: `coachShares/{token}` guarda um RESUMO
    // publicado pelo atleta — nunca uma chave para users/{uid}. A leitura é
    // aberta porque o treinador não tem conta; o token de 160 bits na URL é o
    // segredo. Só o dono grava, e apagar o documento revoga o link na hora.
    //
    // O esquema é fechado. Sem isso, "só o dono grava" ainda deixava a coleção
    // servir de armazenamento livre: campo com qualquer nome, de qualquer
    // tamanho, em qualquer token inventado — e a leitura é PÚBLICA, então o que
    // entrasse aqui sairia para qualquer um com o link. As listas têm teto
    // porque o resumo é de uma janela curta; nada legítimo passa de algumas
    // dezenas de itens.
    function validCoachShare() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.keys().hasOnly(['uid', 'athleteName', 'updatedAt', 'from', 'to',
                             'workouts', 'days', 'weekSummary'])
        && d.keys().hasAll(['uid', 'athleteName', 'updatedAt', 'from', 'to',
                            'workouts', 'days', 'weekSummary'])
        && d.athleteName is string && d.athleteName.size() <= 80
        && d.updatedAt is number
        && d.from is string && d.from.size() <= 10
        && d.to is string   && d.to.size() <= 10
        && d.workouts is list && d.workouts.size() <= 60
        && d.days is list     && d.days.size() <= 60
        && d.weekSummary is map
        && d.weekSummary.keys().hasOnly(['workouts', 'km', 'minutes',
                                         'avgReadiness', 'painFlags']);
    }

    match /coachShares/{token} {
      allow read: if true;

      // O token precisa ter a cara do que `generateShareToken` produz — 20
      // bytes em hexadecimal. Um id curto e adivinhável não seria segredo
      // nenhum, e a leitura aqui é pública.
      allow create: if request.auth != null
                    && entitled()
                    && token.matches('^[0-9a-f]{40}$')
                    && validCoachShare();

      // Republicar só é permitido a quem já é dono daquele token: sem esta
      // linha, escrever o próprio uid num documento alheio bastaria.
      allow update: if request.auth != null
                    && entitled()
                    && resource.data.uid == request.auth.uid
                    && validCoachShare();

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Tudo mais negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
