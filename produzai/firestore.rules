rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // data/* — documentos principais (workouts, diet, profile, projects, books)
      match /data/{docName} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // daily/{date} — hábitos e foco diário (mantido durante transição)
      match /daily/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // mental/{date} — entradas de bem-estar diário (mantido durante transição)
      match /mental/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // dailyMonthly/{yyyy-MM} — agregação mensal de hábitos/foco (1-2 leituras vs 35)
      match /dailyMonthly/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // mentalMonthly/{yyyy-MM} — agregação mensal de bem-estar
      match /mentalMonthly/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // journal/{date} — diário de treino (sentimentos, dores, motivação)
      match /journal/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // journalMonthly/{yyyy-MM} — agregação mensal do diário de treino
      match /journalMonthly/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Leaderboard público (leitura para autenticados, escrita só para o próprio uid).
    // A escrita é validada: esquema fixo, tipos corretos, faixas de valores e
    // uid/inviteCode amarrados à identidade — impede forjar entrada de outro
    // usuário e limita valores absurdos. (Anti-cheat completo de xp exige
    // cálculo server-side; aqui apenas restringimos o que pode ser gravado.)
    function validLeaderboardEntry(userId) {
      let d = request.resource.data;
      return d.uid == userId
        && d.keys().hasOnly(['uid', 'displayName', 'xp', 'streakDays',
                             'weeklyWorkouts', 'weeklyXP', 'weekKey',
                             'inviteCode', 'updatedAt'])
        && d.displayName is string && d.displayName.size() <= 80
        && d.xp is number && d.xp >= 0 && d.xp <= 100000000
        && d.streakDays is number && d.streakDays >= 0 && d.streakDays <= 100000
        && d.weeklyWorkouts is number && d.weeklyWorkouts >= 0 && d.weeklyWorkouts <= 1000
        && d.weeklyXP is number && d.weeklyXP >= 0 && d.weeklyXP <= 100000000
        && d.weekKey is string && d.weekKey.size() <= 12
        && d.inviteCode == userId[0:6].upper()
        && d.updatedAt is number;
    }

    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && validLeaderboardEntry(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Link read-only do treinador: `coachShares/{token}` guarda um RESUMO
    // publicado pelo atleta — nunca uma chave para users/{uid}. A leitura é
    // aberta porque o treinador não tem conta; o token de 160 bits na URL é o
    // segredo. Só o dono grava, e apagar o documento revoga o link na hora.
    match /coachShares/{token} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Tudo mais negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
