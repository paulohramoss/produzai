rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // data/* — documentos principais (workouts, diet, profile, projects, books)
      match /data/{docName} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // daily/{date} — hábitos e foco diário (mantido durante transição)
      match /daily/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // mental/{date} — entradas de bem-estar diário (mantido durante transição)
      match /mental/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // dailyMonthly/{yyyy-MM} — agregação mensal de hábitos/foco (1-2 leituras vs 35)
      match /dailyMonthly/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // mentalMonthly/{yyyy-MM} — agregação mensal de bem-estar
      match /mentalMonthly/{month} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Leaderboard público (leitura para autenticados, escrita só para o próprio uid)
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tudo mais negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
